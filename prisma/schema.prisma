generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PURCHASER
  APPROVER
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  name         String
  passwordHash String
  role         Role      @default(PURCHASER)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  sessions           Session[]
  purchaseRequests   PurchaseRequest[] @relation("PRRequester")
  approvedRequests   PurchaseRequest[] @relation("PRApprover")
  purchaseOrders     PurchaseOrder[]   @relation("POCreator")
  auditLogs          AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Supplier {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  taxCode     String?
  contactName String?
  phone       String?
  email       String?
  address     String?
  bankAccount String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  quotations     Quotation[]
  contracts      Contract[]
}

model Material {
  id          String   @id @default(cuid())
  name        String
  unit        String
  category    String
  stage       String?
  techSpec    String?
  norm        Float?
  normUnit    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prItems        PurchaseRequestItem[]
  poItems        PurchaseOrderItem[]
  stock          StockItem?
  stockMovements StockMovement[]
}

enum PRStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

model PurchaseRequest {
  id           String   @id @default(cuid())
  code         String   @unique
  department   String?
  status       PRStatus @default(DRAFT)
  note         String?
  requesterId  String
  requester    User     @relation("PRRequester", fields: [requesterId], references: [id])
  approverId   String?
  approver     User?    @relation("PRApprover", fields: [approverId], references: [id])
  approvedAt   DateTime?
  approveNote  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Theo dõi tiến độ đơn hàng (import từ file Excel theo dõi phiếu đề xuất)
  proposalCode        String?   // Số phiếu đề xuất (mã nội bộ do người gửi đặt)
  senderName          String?   // Người gửi (tên tự do, có thể không phải user hệ thống)
  receivedDate        DateTime? // Ngày nhận
  company             String?   // Công ty (ERC-B, BP, SV...)
  requiredTime        String?   // Thời gian yêu cầu hoàn thành
  deliveryPlan        String?   // Kế hoạch giao hàng
  priorityLevel       Int?      // Cấp độ yêu cầu
  purchaseStaff       String?   // Nhân sự thu mua phụ trách
  lastUpdated         DateTime? // Ngày cập nhật
  supplierName        String?   // NCC
  poNumber            String?   // Số đơn đặt hàng
  orderStatus         String?   // Tình trạng đơn hàng (tiến độ tổng quát)
  accountingMaterial  String?   // Kế toán vật tư
  taxStatus           String?   // Thuế
  accountingPayment   String?   // Kế toán thanh toán
  paymentStatus       String?   // Thanh toán
  receivedStatus      String?   // Nhận hàng
  warehouseConfirm    String?   // Xác nhận kho
  surplusShortage     String?   // Thừa/thiếu

  items          PurchaseRequestItem[]
  purchaseOrders PurchaseOrder[]
}

model PurchaseRequestItem {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  materialId        String?
  material          Material?       @relation(fields: [materialId], references: [id])
  name              String
  unit              String
  quantity          Float
  estimatedPrice    Float?
  note              String?
}

enum POStatus {
  DRAFT
  SENT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id                String    @id @default(cuid())
  code              String    @unique
  supplierId        String
  supplier          Supplier  @relation(fields: [supplierId], references: [id])
  purchaseRequestId String?
  purchaseRequest   PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  status            POStatus  @default(DRAFT)
  expectedDate      DateTime?
  note              String?
  creatorId         String
  creator           User      @relation("POCreator", fields: [creatorId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Thông tin tài chính đơn hàng (import từ file Đơn đặt hàng mua)
  orderDate      DateTime? // Ngày lập đơn hàng
  company        String?   // Công ty / Xí nghiệp (VD: ERC)
  goodsAmount    Float?    // Tiền hàng
  taxAmount      Float?    // Tiền thuế
  totalAmount    Float?    // Tổng tiền
  currency       String?   // Tiền tệ (USD, KHR...)
  exchangeRate   Float?    // Tỷ giá
  creatorName    String?   // Người lập (tên tự do)
  categoryCode   String?   // Phân loại hàng
  categoryName   String?   // Tên phân loại hàng

  items       PurchaseOrderItem[]
  contracts   Contract[]
  payments    Payment[]
  stockMoves  StockMovement[]
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  materialId      String?
  material        Material?     @relation(fields: [materialId], references: [id])
  name            String
  unit            String
  quantity        Float
  unitPrice       Float
  receivedQty     Float         @default(0)
}

model Quotation {
  id         String   @id @default(cuid())
  code       String   @unique
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  content    String?
  totalValue Float?
  validUntil DateTime?
  createdAt  DateTime @default(now())
}

model Contract {
  id              String         @id @default(cuid())
  code            String         @unique
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  startDate       DateTime?
  endDate         DateTime?
  value           Float?
  notes           String?
  createdAt       DateTime       @default(now())
}

model StockItem {
  id         String   @id @default(cuid())
  materialId String   @unique
  material   Material @relation(fields: [materialId], references: [id])
  quantity   Float    @default(0)
  updatedAt  DateTime @updatedAt
}

enum StockMoveType {
  IN
  OUT
  ADJUST
}

model StockMovement {
  id              String        @id @default(cuid())
  materialId      String
  material        Material      @relation(fields: [materialId], references: [id])
  type            StockMoveType
  quantity        Float
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  note            String?
  createdAt       DateTime      @default(now())
}

model Payment {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  amount          Float
  method          String?
  note            String?
  paidAt          DateTime      @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  detail     String?
  createdAt  DateTime @default(now())
}
